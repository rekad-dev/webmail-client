# JMAP session discovery URL. Prefer an internal HTTPS endpoint when one is
# available to the application host. The public mail hostname is verified today.
STALWART_JMAP_SESSION_URL=https://mail.rekad.id/.well-known/jmap

# Origins allowed for discovery redirects and URLs advertised by the JMAP
# session. Add another origin only when Stalwart intentionally serves a JMAP
# endpoint from it.
STALWART_JMAP_TRUSTED_ORIGINS=https://mail.rekad.id

# Set true only when using an explicitly trusted private network origin.
STALWART_JMAP_ALLOW_INSECURE_HTTP=false

# Dedicated test account for the read-only JMAP smoke check. Keep values in
# .env.local; never add NEXT_PUBLIC_ to these names.
JMAP_TEST_USERNAME=
JMAP_TEST_PASSWORD=

# Auth.js application secret. Generate a unique value with:
# node -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("base64url"))'
AUTH_SECRET=

# Existing Stalwart OAuth client ID is pinned to `webmail` in auth.ts.
AUTH_STALWART_ISSUER=https://mail.rekad.id
AUTH_STALWART_TOKEN_ENDPOINT=https://mail.rekad.id/auth/token
AUTH_STALWART_SECRET=
# Must match the existing `webmail` record: none, client_secret_basic,
# or client_secret_post. The implementation defaults to client_secret_basic.
AUTH_STALWART_TOKEN_AUTH_METHOD=client_secret_basic

# Shared PostgreSQL database for server-side sessions; never use function memory.
DATABASE_URL=

# Separate 32-byte base64url key for AES-256-GCM token encryption. Generate
# with: node -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("base64url"))'
OAUTH_TOKEN_ENCRYPTION_KEY=
# Optional previous key during rotation; remove after all sessions expire.
OAUTH_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# STALWART_OAUTH_ADMIN_API_KEY is never used by application auth or mailbox access.
